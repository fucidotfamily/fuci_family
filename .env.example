# ─── Fuci: environment variables ───────────────────────────────────────────
# Runs on Arc Mainnet with real USDC. Circle Gateway nanopayments are
# permissionless: no Circle account is needed. Open /setup for guided steps.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Your own wallet (e.g. Rabby). Receives x402 payments and signs you in to /setup.
FUCI_SELLER_ADDRESS=
# The house agent's wallet key. Generate it on /setup (in your browser).
# Keep only a small USDC balance in it.
AGENT_PRIVATE_KEY=
# Upstash Redis for stats, leaderboard and spawned agents: don't type these.
# Vercel → your project → Storage → Upstash Redis → Connect.

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# Passkey wallets on /spawn. console.circle.com → Modular Wallets → Client Key.
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
# $FUCI contract address, after it launches on Argus.
NEXT_PUBLIC_FUCI_TOKEN=
# Wallet that receives the 5% kelp-restoration tithe (shown on the site).
NEXT_PUBLIC_TITHE_ADDRESS=
# USDC per day the house agent spends sponsoring the website playground.
PLAYGROUND_DAILY_USDC=0.25
# Claude writes the agent answers. Without it, answers are built from the data.
ANTHROPIC_API_KEY=
# Private Arc RPCs if the public ones rate-limit you.
ARGUS_RPC_URL=
ARC_RPC_URL=
# Alternative agent wallet via Circle Wallets (needs Circle mainnet access).
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Switch payments to Arc Testnet for trials.
# NEXT_PUBLIC_ARC_NETWORK=testnet
# ERC-8183 job board: defaults to Circle's reference contract on Arc Testnet.
# NEXT_PUBLIC_ERC8183_NETWORK=mainnet
# NEXT_PUBLIC_ERC8183_ADDRESS=
# "Connect X" on agent cards (developer.x.com, OAuth 2.0 Web App; callback https://fuci.family/api/x/callback).
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Agent automation (all optional): scheduler token, wallet encryption secret, Vercel daily cron.
# QSTASH_TOKEN=
# AGENT_WALLET_SECRET=
# CRON_SECRET=
# "Buy USDC with card" (Circle Onramp Kit): kit key from the Circle Console (kit keys). Keep it server-side.
# Leaving both base URLs unset means production: real card payments, USDC on Arc mainnet.
# For Arc testnet trials set both to Circle's sandbox (and use a sandbox kit key):
#   ONRAMP_API_BASE_URL=https://api-test.circle.com
#   NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
# ONRAMP_API_KEY=
